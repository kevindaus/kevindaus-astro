---
// Articles index — plain list with tag filtering. H1, subtitle, titles, dates and descriptions are verbatim.
// The filter fades the list out, reflows it, and fades it back in (instant under reduced motion).
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleItem from '../components/ArticleItem.astro';
import { seo } from '../data/seo';
import { getPosts, postPath } from '../lib/content';
import { breadcrumb } from '../lib/schema';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
const site = Astro.site!.href;
const url = new URL('/articles/', Astro.site).href;
---
<BaseLayout title={seo.articles.title} description={seo.articles.description} path="/articles/" pageType="CollectionPage"
  schemaNodes={[
    breadcrumb(site, [{ name: 'Articles', url }]),
    { '@type': 'ItemList', '@id': `${url}#list`, itemListElement: posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(postPath(p), Astro.site).href, name: p.data.title })) },
  ]}>
  <section class="mx-auto max-w-wide px-5 pt-12 pb-20 sm:px-8 sm:pt-16 lg:px-12">
    <Breadcrumbs items={[{ label: 'Articles' }]} />
    <h1 class="mt-8 text-hero font-bold">Articles</h1>
    <p class="mt-6 max-w-[44ch] text-xl leading-snug text-muted">Read the latest blog posts about general web development , Laravel, PHP and WordPress</p>

    <div class="mt-14 flex flex-wrap items-center gap-2 border-t border-fg pt-6" role="group" aria-label="Filter by tag" data-filter>
      <span class="mono mr-3 text-muted" aria-hidden="true">Filter</span>
      <button type="button" class="tag" data-tag="*" aria-pressed="true">All</button>
      {tags.map((t) => <button type="button" class="tag" data-tag={t} aria-pressed="false">{t}</button>)}
    </div>
    <p class="sr-only" aria-live="polite" data-filter-status></p>

    <ul class="filter-list reveal-stagger mt-6 border-t border-line" data-filter-list>
      {posts.map((p, i) => <ArticleItem post={p} heading="h2" showDescription showTags index={i} />)}
    </ul>
  </section>
</BaseLayout>

<script>
  function init() {
    const group = document.querySelector<HTMLElement>('[data-filter]');
    const list = document.querySelector<HTMLElement>('[data-filter-list]');
    const status = document.querySelector<HTMLElement>('[data-filter-status]');
    if (!group || !list || group.dataset.ready) return;
    group.dataset.ready = '1';
    const rows = [...list.querySelectorAll<HTMLElement>(':scope > li')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const apply = (tag: string) => {
      let n = 0;
      rows.forEach((r) => {
        const on = tag === '*' || (r.dataset.tags ?? '').split('|').includes(tag);
        r.hidden = !on;
        if (on) n++;
      });
      if (status) status.textContent = `${n} article${n === 1 ? '' : 's'}${tag === '*' ? '' : ` tagged ${tag}`}`;
    };
    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-tag]');
      if (!btn || btn.getAttribute('aria-pressed') === 'true') return;
      group.querySelectorAll('button[data-tag]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      const tag = btn.dataset.tag!;
      if (reduce) return apply(tag);
      list.classList.add('is-filtering');
      setTimeout(() => { apply(tag); list.classList.remove('is-filtering'); }, 150);
    });
  }
  document.addEventListener('astro:page-load', init);
</script>
