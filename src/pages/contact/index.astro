---
// Contact — form (name, email, project type, message) → /api/contact (functions/api/contact.ts).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactForm from '../../components/ContactForm.astro';
import { seo } from '../../data/seo';
import { site } from '../../data/site';
import { contactCopy } from '../../data/home';
import { breadcrumb } from '../../lib/schema';

const url = new URL('/contact/', Astro.site).href;
---
<BaseLayout title={seo.contact.title} description={seo.contact.description} path="/contact/" pageType="ContactPage"
  schemaNodes={[breadcrumb(Astro.site!.href, [{ name: 'Contact', url }])]}>
  <div class="mx-auto max-w-wide px-5 pt-12 sm:px-8 sm:pt-16 lg:px-12">
    <Breadcrumbs items={[{ label: 'Contact' }]} />
    <h1 class="mt-8 max-w-[14ch] text-hero font-bold">{contactCopy.heading}</h1>
    <div class="mt-14 grid gap-12 border-t border-fg pt-8 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4">
        <p class="max-w-[34ch] text-xl leading-snug">{contactCopy.intro}</p>
        <dl class="mt-10 space-y-3 border-t border-line pt-6">
          {site.email && <div class="flex gap-3"><dt class="mono w-24 text-muted">Email</dt><dd><a href={`mailto:${site.email}`} class="text-link link-underline">{site.email}</a></dd></div>}
          <div class="flex gap-3"><dt class="mono w-24 text-muted">LinkedIn</dt><dd><a href={site.linkedin} class="text-link link-underline" rel="noopener" target="_blank">kevinflorenzdaus<span class="sr-only"> (opens in a new tab)</span></a></dd></div>
        </dl>
      </div>
      <div class="md:col-span-7 md:col-start-6">
        <ContactForm />
      </div>
    </div>
  </div>
</BaseLayout>
