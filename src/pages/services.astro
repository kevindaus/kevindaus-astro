---
// Services — every "What I do" row on the homepage links to a section here.
// Lead paragraphs are verbatim from the live site; `body` and `included` are DRAFT copy awaiting approval
// (src/data/services.ts). The subtitle is the homepage's own section heading, verbatim.
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { seo } from '../data/seo';
import { site as siteData } from '../data/site';
import { services } from '../data/services';
import { getPosts, postPath } from '../lib/content';
import { breadcrumb, mainEntityId } from '../lib/schema';

const posts = await getPosts();
const postByPath = new Map(posts.map((p) => [postPath(p), p]));
const site = Astro.site!.href;
const url = new URL('/services/', Astro.site).href;
const person = mainEntityId(site, 'Person');
const n = (i: number) => String(i + 1).padStart(2, '0');

const serviceNodes = services.map((s) => ({
  '@type': 'Service',
  '@id': `${url}#${s.slug}`,
  name: s.title,
  description: s.lead[0],
  url: `${url}#${s.slug}`,
  provider: { '@id': person },
}));
---
<BaseLayout title={seo.services.title} description={seo.services.description} path="/services/"
  schemaNodes={[breadcrumb(site, [{ name: 'Services', url }]), ...serviceNodes]}>
  <div class="mx-auto max-w-wide px-5 pt-12 sm:px-8 sm:pt-16 lg:px-12">
    <Breadcrumbs items={[{ label: 'Services' }]} />
    <h1 class="mt-8 text-hero font-bold">Services</h1>
    <p class="mt-6 max-w-[40ch] text-xl leading-snug text-muted">Things I do to help you with your business.</p>

    <nav aria-label="Services on this page" class="mt-10">
      <ol class="mono flex flex-wrap gap-x-8 gap-y-3 text-muted">
        {services.map((s, i) => <li><a href={`#${s.slug}`} class="link-underline hover:text-fg"><span class="text-accent-ink">{n(i)}</span> {s.title}</a></li>)}
      </ol>
    </nav>

    <div class="mt-12 border-t border-fg">
      {services.map((s, i) => (
        <section id={s.slug} class="grid scroll-mt-24 gap-x-8 gap-y-6 border-b border-line py-14 md:grid-cols-12" aria-labelledby={`${s.slug}-title`}>
          <div class="reveal md:col-span-4">
            <p class="mono text-accent-ink">{n(i)}</p>
            <h2 id={`${s.slug}-title`} class="mt-3 text-heading">{s.title}</h2>
          </div>
          <div class="reveal max-w-read md:col-span-7 md:col-start-6">
            <div class="space-y-4 text-[1.0625rem] leading-relaxed">{s.lead.map((p) => <p>{p}</p>)}</div>
            <!-- DRAFT copy below: needs Kevin's approval (src/data/services.ts) -->
            <div class="mt-4 space-y-4 text-muted">{s.body.map((p) => <p>{p}</p>)}</div>
            <h3 class="mono mt-8 font-normal text-muted">What’s included</h3>
            <ul class="mt-3 grid gap-x-8 gap-y-1.5 sm:grid-cols-2">
              {s.included.map((t) => <li class="flex gap-2.5"><span class="text-accent-ink" aria-hidden="true">—</span>{t}</li>)}
            </ul>
            {s.related && postByPath.get(s.related) && (
              <a href={s.related} class="group mt-8 flex items-center justify-between gap-6 border border-line bg-surface p-5 hover:border-fg">
                <span><span class="mono block text-muted">Related article</span><span class="item-title mt-1 block font-medium leading-snug">{postByPath.get(s.related)!.data.title}</span></span>
                <span class="arrow text-accent-ink" aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </section>
      ))}
    </div>

    <div class="reveal mt-24 flex flex-wrap items-end justify-between gap-8 border-t border-fg pt-8">
      <h2 class="max-w-[14ch] text-display">Need a hand on your project?</h2>
      <a href={siteData.contactPath} class="btn btn-primary">Get in touch <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</BaseLayout>
