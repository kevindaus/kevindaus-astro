---
// Every article at its preserved WordPress URL (/YYYY/MM/DD/slug/).
// Title, date, reading time, tags · auto TOC (sticky on desktop) · reading progress · Shiki code with copy ·
// related articles (shared tags) · prev/next · per-post Open Graph image (/og/<id>.png).
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import ArticleItem from '../components/ArticleItem.astro';
import { getPosts, postPath, renderEntry, fmtDate, readingTime, relatedPosts, type Post } from '../lib/content';
import { breadcrumb, mainEntityId } from '../lib/schema';
import { site as siteData } from '../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const seen = new Map<string, string>();
  for (const p of posts) {
    const path = postPath(p);
    if (seen.has(path)) throw new Error(`Two posts share the URL ${path}: ${seen.get(path)} and ${p.id}`);
    seen.set(path, p.id);
  }
  // live navigation: "Previous" = older post, "Next" = newer post
  return posts.map((post, i) => ({
    params: { path: postPath(post).slice(1, -1) },
    props: { post, newer: posts[i - 1], older: posts[i + 1], related: relatedPosts(post, posts) },
  }));
}

const { post, newer, older, related } = Astro.props as { post: Post; newer?: Post; older?: Post; related: Post[] };
const { Content, headings } = await renderEntry(post);
const { title, description, date, updated, tags, seoTitle, seoDescription } = post.data;
const path = postPath(post);
const site = Astro.site!.href;
const url = new URL(path, Astro.site).href;
const modified = (updated ?? date).toISOString();
const ogImage = `/og/${post.id}.png`;
const entity = mainEntityId(site, siteData.org.type);
const minutes = readingTime(post.body);
const toc = post.data.toc ?? headings.filter((h) => h.depth === 2 || h.depth === 3).map((h) => ({ id: h.slug, label: h.text, depth: h.depth }));

const article = {
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: title.length > 110 ? (seoTitle ?? title).slice(0, 110) : title,
  datePublished: date.toISOString(),
  dateModified: modified,
  author: { '@id': entity },
  publisher: { '@id': entity },
  mainEntityOfPage: { '@id': `${url}#webpage` },
  articleSection: tags,
  keywords: tags.join(', '),
  timeRequired: `PT${minutes}M`,
  inLanguage: siteData.lang,
  image: new URL(ogImage, Astro.site).href,
  description: seoDescription ?? description,
};
---
<BaseLayout
  title={seoTitle ?? `${title} - Kevin Florenz Daus - PHP Programmer / WordPress Developer`}
  description={seoDescription ?? description}
  path={path}
  ogType="article"
  ogImage={ogImage}
  published={date.toISOString()}
  modified={modified}
  schemaNodes={[article, breadcrumb(site, [{ name: 'Articles', url: new URL('/articles/', Astro.site).href }, { name: title, url }])]}
>
  <ReadingProgress />
  <div class="mx-auto max-w-wide px-5 pt-12 sm:px-8 sm:pt-16 lg:px-12">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,42.5rem)_1fr] lg:gap-16">
      <article class="min-w-0">
        <header>
          <Breadcrumbs items={[{ label: 'Articles', href: '/articles/' }]} />
          <h1 class="mt-8 text-title font-bold" transition:name={`post-title-${post.id}`}>{title}</h1>
          <p class="mono mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-subtle">
            <time datetime={date.toISOString()}>{fmtDate(date)}</time>
            <span aria-hidden="true">·</span>
            <span>{minutes} min read</span>
            {updated && <><span aria-hidden="true">·</span><span>updated <time datetime={updated.toISOString()}>{fmtDate(updated)}</time></span></>}
          </p>
          {tags.length > 0 && <p class="mt-4 flex flex-wrap gap-1.5">{tags.map((t) => <span class="tag">{t}</span>)}</p>}
        </header>

        <div class="prose mt-10 border-t border-line pt-10">
          <Content />
        </div>
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-24 pt-1"><TableOfContents items={toc} /></div>
      </aside>
    </div>

    <div class="max-w-read">
      {related.length > 0 && (
        <section class="mt-20" aria-labelledby="related">
          <h2 id="related" class="border-t border-fg pt-6 text-heading">Related articles</h2>
          <ul class="mt-6 border-t border-line">
            {related.map((p, i) => <ArticleItem post={p} index={i} />)}
          </ul>
        </section>
      )}

      <nav aria-label="Previous and next article" class="mt-16 grid gap-px border border-line bg-line sm:grid-cols-2">
        {older ? (
          <a href={postPath(older)} class="group block bg-bg p-5">
            <span class="mono text-subtle"><span aria-hidden="true">←</span> Previous</span>
            <span class="item-title mt-2 block font-medium leading-snug">{older.data.title}</span>
          </a>
        ) : <span class="hidden bg-bg sm:block"></span>}
        {newer ? (
          <a href={postPath(newer)} class="group block bg-bg p-5 sm:text-right">
            <span class="mono text-subtle">Next <span class="arrow" aria-hidden="true">→</span></span>
            <span class="item-title mt-2 block font-medium leading-snug">{newer.data.title}</span>
          </a>
        ) : <span class="hidden bg-bg sm:block"></span>}
      </nav>
    </div>
  </div>
</BaseLayout>
