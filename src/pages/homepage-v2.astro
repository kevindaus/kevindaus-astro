---
// Homepage v2 — DRAFT layout exploration (2026-11-23, Kevin's request): same content as /, re-laid out
// and refocused on "web developer with WordPress expertise". Not linked, noindex, out of the sitemap.
// Copy is verbatim from the live site; the only new words are the H1 (option 3, chosen by Kevin 2026-11-23), the "Stack"
// label and the group labels. Logged in docs/implementation-progress.md → Copy Awaiting Approval.
import { Image, Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Ticker from '../components/Ticker.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CategoryChip from '../components/CategoryChip.astro';
import { site } from '../data/site';
import { seo } from '../data/seo';
import { services } from '../data/services';
import { jobs } from '../data/experience';
import { getPosts, postPath, fmtDate } from '../lib/content';
import mandy from '../assets/people/mandy-pawley.jpg';
import stuart from '../assets/people/stuart-cox.jpg';
import banner from '../assets/people/kevin-noir-banner.png';

const svc = (slug: string) => services.find((s) => s.slug === slug)!;
const featured = svc('wordpress-development');
const wpStack = ['wordpress-custom-plugin-development', 'website-maintenance', 'on-page-seo'].map(svc);
const beyond = svc('general-web-development');

// WordPress posts first, then the rest (each group newest first)
const all = await getPosts();
const isWp = (p: (typeof all)[number]) => p.data.categories.includes('WordPress');
const posts = [...all.filter(isWp), ...all.filter((p) => !isWp(p))];

// the WordPress roles (2019 → now), verbatim from /about-me/
const wpJobs = jobs.filter(([role]) => /wordpress/i.test(role));


const whatIDoBest = ['WordPress Development', 'On-Site SEO', 'WordPress Custom Plugin Development', 'General Website Development', 'Website Maintenance and Support Services'];
// tools the live site itself names (services copy + posts)
const stack = ['WordPress', 'Elementor', 'Crocoblock', 'WooCommerce', 'WP-CLI', 'Laravel', 'Yii'];
---
<BaseLayout title="Homepage v2 (draft) - Kevin Florenz Daus" description={seo.home.description} path="/homepage-v2/" noindex>
  <!-- HERO: full-bleed noir portrait (Kevin's photo, 2026-11-23) fading into the page; text sits on the dark side -->
  <section class="relative flex flex-col justify-end overflow-hidden pt-[46svh] pb-10 sm:pt-[52svh] lg:min-h-[100svh] lg:max-h-[1000px] lg:pt-36">
    <!-- masked (not overlaid) so the photo dissolves into the page with no seam -->
    <div class="hero-media absolute inset-x-0 top-16 h-[74svh] lg:inset-y-0 lg:right-0 lg:left-auto lg:h-full lg:w-[62%]">
      <Picture src={banner} formats={['avif', 'webp']} alt="Kevin Florenz Daus" widths={[480, 768, 1024, 1168]}
        sizes="(min-width: 1024px) 62vw, 100vw" loading="eager" fetchpriority="high"
        class="h-full w-full object-cover object-[55%_0%] brightness-[.92] contrast-[1.05] lg:object-[55%_15%]" />
      <div class="absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-noir/70 to-transparent" aria-hidden="true"></div>
    </div>

    <div class="relative mx-auto grid w-full max-w-7xl items-end gap-10 px-4 sm:px-6 lg:grid-cols-12">
      <div class="relative z-10 lg:col-span-7">
        <p class="reveal flex items-center gap-3 text-xs uppercase tracking-[.3em] text-bone/80"><span class="h-px w-10 bg-bone/60" aria-hidden="true"></span> Kevin Florenz Daus</p>
        <h1 class="reveal display mt-6 text-display-hero [text-shadow:0_2px_24px_rgba(0,0,0,.6)]">
          <span class="mb-[.1em] inline-block bg-bone px-[.12em] pt-[.08em] pb-[.02em] leading-[.9] text-noir [text-shadow:none]">WordPress</span>
          <span class="block">Developer</span>
          <span class="mt-[.3em] block text-[.46em] leading-[1]"><span class="block"><span class="text-bone/70">and</span> <span class="lg:text-transparent lg:[-webkit-text-stroke:1.5px_var(--color-bone)]">Laravel</span></span><span class="block">when it needs more</span></span>
        </h1>
        <div class="reveal mt-10 flex flex-wrap gap-3">
          <a href={site.contactUrl} class="group inline-flex min-h-12 items-center gap-4 bg-bone px-7 py-4 text-xs font-bold uppercase tracking-[.25em] text-noir transition hover:bg-white">Contact Me <span class="transition group-hover:translate-x-1" aria-hidden="true">→</span></a>
          <a href="/services/" class="inline-flex min-h-12 items-center border border-white/40 bg-noir/40 px-7 py-4 text-xs font-bold uppercase tracking-[.25em] backdrop-blur-sm transition hover:border-bone">Services</a>
        </div>
      </div>
      <div class="reveal relative z-10 lg:col-span-5 lg:justify-self-end">
        <div class="w-full border border-white/15 bg-noir/90 shadow-[12px_12px_0_rgba(0,0,0,.6)] backdrop-blur-sm sm:w-80">
          <div class="flex items-center justify-between border-b border-white/15 px-4 py-2 text-[11px] text-smoke"><span>~/kevin</span><span>zsh</span></div>
          <div class="p-4 text-[12.5px] leading-relaxed">
            <p class="text-smoke" data-type>$ whoami</p>
            <p class="caret">A web developer focusing in WordPress CMS , Laravel and Yii.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- stack strip: real list (was a decorative aria-hidden line on v1) -->
    <div class="reveal relative mx-auto mt-12 w-full max-w-7xl px-4 sm:px-6">
      <div class="flex flex-col gap-3 border-t border-white/15 pt-5 sm:flex-row sm:items-baseline sm:gap-8">
        <p class="text-[11px] uppercase tracking-[.3em] text-smoke">Stack</p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-xs uppercase tracking-[.2em]" aria-label="Stack">
          {stack.map((t, i) => <li class:list={[i < 5 ? 'text-bone' : 'text-smoke']}>{t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <Ticker items={whatIDoBest} label="What I do best" />

  <!-- 01 ABOUT: statement (new copy, replaces the meta-description belief sentence on this page only) -->
  <section id="about" class="py-24 sm:py-36">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-12 lg:grid-rows-[auto_1fr] lg:gap-y-10">
      <div class="reveal lg:col-span-4">
        <Eyebrow n="01" text="A bit about me" />
        <!-- intro + statement: new copy approved in chat by Kevin, 2026-11-23 -->
        <p class="mt-8 max-w-sm text-base leading-relaxed text-bone/80">Hi, I'm Kevin Florenz Daus, a WordPress and Laravel developer.</p>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          {site.aboutSocials.map((s) => <li><a href={s.href} class="link-u inline-block py-2" rel="me noopener" target="_blank">{s.label} ↗</a></li>)}
        </ul>
      </div>
      <div class="lg:col-span-8 lg:row-span-2">
        <h2 class="reveal display text-[clamp(2.75rem,5vw,4.75rem)] leading-[1.22]">
          <span class="block">Not just fancy colours and dancing text.</span> <span class="mt-[.15em] block">A website that <span class="bg-bone px-2 text-noir [box-decoration-break:clone]">speaks for your business</span>.</span>
        </h2>
      </div>
      <!-- after the statement in source (mobile order); sits under the socials on desktop -->
      <div class="reveal lg:col-span-4 lg:col-start-1 lg:row-start-2">
        <a href="/about-me/" class="inline-flex min-h-12 items-center gap-4 border border-white/30 px-7 py-4 text-xs font-bold uppercase tracking-[.25em] transition hover:border-bone">About Me <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 02 SERVICES: WordPress first and largest, the rest of the web work after -->
  <section class="pb-24 sm:pb-36">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="reveal grid gap-6 border-t border-white/15 pt-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-9">
          <Eyebrow n="02" text="What I do best" />
          <h2 class="display mt-5 text-display-section">Things I do to help you with your business.</h2>
        </div>
        <a href="/services/" class="link-u justify-self-start py-2 text-xs font-bold uppercase tracking-[.25em] lg:col-span-3 lg:justify-self-end">All services <span aria-hidden="true">→</span></a>
      </div>

      <p class="reveal mt-16 text-[11px] uppercase tracking-[.3em] text-smoke">[A] WordPress</p>
      <div class="mt-4 grid border-t border-l border-white/15 lg:grid-cols-12">
        <article class="svc reveal group relative flex flex-col border-r border-b border-white/15 p-6 sm:p-10 lg:col-span-7">
          <div class="flex items-baseline justify-between text-xs uppercase tracking-[.25em] text-smoke"><span>No. 01</span><span aria-hidden="true" class="transition group-hover:translate-x-1 group-hover:text-bone">→</span></div>
          <div class="mt-6 aspect-[4/3] overflow-hidden"><Image src={featured.image!.src} alt={featured.image!.alt} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 680px, 92vw" class="noir-img h-full w-full object-cover" /></div>
          <h3 class="display mt-8 text-5xl sm:text-6xl"><a href={`/services/#${featured.slug}`} class="after:absolute after:inset-0">{featured.title}</a></h3>
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-bone/80 sm:text-lg">{featured.lead[0]}</p>
          <p class="mt-4 max-w-2xl border-l border-bone pl-4 text-bone">{featured.lead[1]}</p>
        </article>
        <div class="grid lg:col-span-5">
          {wpStack.map((s, i) => (
            <article class="svc reveal group relative flex flex-col border-r border-b border-white/15 p-6 sm:p-8">
              <div class="flex items-baseline justify-between text-xs uppercase tracking-[.25em] text-smoke"><span>No. 0{i + 2}</span><span aria-hidden="true" class="transition group-hover:translate-x-1 group-hover:text-bone">→</span></div>
              <h3 class="display mt-5 text-3xl leading-none sm:text-4xl"><a href={`/services/#${s.slug}`} class="after:absolute after:inset-0">{s.title}</a></h3>
              <p class="mt-4 text-sm leading-relaxed text-bone/75">{s.lead[0]}</p>
              {s.lead[1] && <p class="mt-3 text-sm leading-relaxed">{s.lead[1]}</p>}
            </article>
          ))}
        </div>
      </div>

      <p class="reveal mt-16 text-[11px] uppercase tracking-[.3em] text-smoke">[B] PHP / Laravel / Yii</p>
      <article class="svc reveal group relative mt-4 grid gap-8 border border-white/15 p-6 sm:p-10 md:grid-cols-12">
        <div class="aspect-[16/9] overflow-hidden md:col-span-5"><Image src={beyond.image!.src} alt={beyond.image!.alt} widths={[480, 768]} sizes="(min-width: 768px) 460px, 92vw" class="noir-img h-full w-full object-cover" /></div>
        <div class="md:col-span-7">
          <div class="flex items-baseline justify-between text-xs uppercase tracking-[.25em] text-smoke"><span>No. 05</span><span aria-hidden="true" class="transition group-hover:translate-x-1 group-hover:text-bone">→</span></div>
          <h3 class="display mt-5 text-4xl sm:text-5xl"><a href={`/services/#${beyond.slug}`} class="after:absolute after:inset-0">{beyond.title}</a></h3>
          <p class="mt-5 text-bone/75">{beyond.lead[0]}</p>
          <p class="mt-4">{beyond.lead[1]}</p>
        </div>
      </article>
    </div>
  </section>

  <!-- 03 EXPERIENCE: the WordPress track record, straight from /about-me/ -->
  <section class="border-y border-white/10 bg-noir-900 py-24 sm:py-36">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-12">
      <div class="reveal lg:col-span-4">
        <Eyebrow n="03" text="Experience" />
        <h2 class="display mt-5 text-[clamp(3rem,5vw,4.75rem)]">Experience</h2>
        <ul class="mt-10 space-y-4">
          <li class="relative pl-7 text-bone/80"><span class="absolute left-0 text-smoke" aria-hidden="true">—</span>Developed modern, responsive and SEO optimized site using WordPress CMS platform that streamlines clients and consumer business.</li>
          <li class="relative pl-7 text-bone/80"><span class="absolute left-0 text-smoke" aria-hidden="true">—</span>Perform website management skills that keep up and ready for business.</li>
        </ul>
        <a href="/about-me/" class="mt-10 inline-flex min-h-12 items-center gap-4 border border-white/30 px-7 py-4 text-xs font-bold uppercase tracking-[.25em] transition hover:border-bone">About Me <span aria-hidden="true">→</span></a>
      </div>
      <ol class="border-t border-white/15 lg:col-span-8">
        {wpJobs.map(([role, org, dates, loc], i) => (
          <li class="reveal grid gap-2 border-b border-white/15 py-7 sm:grid-cols-12 sm:gap-6">
            <span class="text-xs text-smoke sm:col-span-1">{String(i + 1).padStart(2, '0')}</span>
            <div class="sm:col-span-7">
              <h3 class="display text-2xl leading-none sm:text-3xl">{role}</h3>
              <p class="mt-2 text-sm text-bone/75">{org}</p>
            </div>
            <div class="text-xs uppercase leading-loose tracking-[.18em] text-smoke sm:col-span-4 sm:text-right">
              <p class="text-bone">{dates}{dates.includes('CURRENT') && <span class="ml-3 inline-block h-2 w-2 bg-bone align-middle" aria-hidden="true"></span>}</p>
              <p>{loc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 04 ARTICLES: cards, WordPress posts first -->
  <section id="articles" class="py-24 sm:py-36">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="reveal flex flex-wrap items-end justify-between gap-6">
        <div>
          <Eyebrow n="04" text="Articles" />
          <h2 class="display mt-5 text-display-section">Articles</h2>
        </div>
        <a href="/articles/" class="link-u py-2 text-xs font-bold uppercase tracking-[.25em]">Articles <span aria-hidden="true">→</span></a>
      </div>
      <ul class="mt-12 grid border-t border-l border-white/15 md:grid-cols-2">
        {posts.map((p) => (
          <li class="reveal border-r border-b border-white/15">
            <a href={postPath(p)} class="group flex h-full flex-col p-6 transition hover:bg-white/[.03] sm:p-8">
              <div class="flex flex-wrap items-center gap-3">
                <p class="text-xs uppercase tracking-[.2em] text-smoke"><time datetime={p.data.pubDate.toISOString()}>{fmtDate(p.data.pubDate)}</time></p>
                <div class="flex flex-wrap gap-1.5">{p.data.categories.map((c) => <CategoryChip label={c} />)}</div>
              </div>
              <h3 class="display mt-6 text-2xl leading-[1.02] transition group-hover:translate-x-1 sm:text-3xl">{p.data.title}</h3>
              <p class="mt-4 text-sm text-bone/65">{p.data.excerpt}</p>
              <p class="mt-auto pt-6 text-xs font-bold uppercase tracking-[.25em] underline-offset-4 group-hover:underline">Read More »</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 05 TESTIMONIALS: moved to the end so the proof sits right before "Need a hand on your project?" -->
  <section class="bg-bone py-24 text-noir sm:py-36">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="reveal border-b border-noir/20 pb-8">
        <Eyebrow text="Testimonial" n="05" tone="light" />
        <h2 class="display mt-5 text-display-section">My Client Said</h2>
      </div>
      <div class="mt-14 grid gap-14 lg:grid-cols-12 lg:gap-16">
        <figure class="reveal flex flex-col lg:col-span-7">
          <p class="display text-[7rem] leading-[.6] text-noir/15" aria-hidden="true">“</p>
          <blockquote class="text-base leading-relaxed text-noir/80 sm:text-lg">
            <span class="display mb-6 block text-4xl leading-none text-noir sm:text-5xl">Kevin is one of the finest developers ive had the pleasure of dealing with.</span>
            Kevin was a full time member of my team for over 2 years, and I couldn't have been happier with what we achieved. No job was too small or too big for Kevin. His infectious attitude to work was a pleasure to deal with on a daily basis. Whilst im sad Kevin is no longer part of our team, I wish him continued success into the future, and look forward to witnessing his continued ascent as a developer.
          </blockquote>
          <figcaption class="mt-10 flex items-center gap-4 border-t border-noir/20 pt-6">
            <Image src={stuart} alt="Stuart Cox" width={112} height={112} class="h-14 w-14 object-cover grayscale contrast-125" />
            <div class="text-sm"><p class="font-bold uppercase tracking-[.15em]">Stuart Cox</p><p class="text-ash">Digital Consultant / Creative Director</p></div>
          </figcaption>
        </figure>
        <figure class="reveal flex flex-col border-t border-noir/20 pt-10 lg:col-span-5 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-16">
          <p class="display text-[7rem] leading-[.6] text-noir/15" aria-hidden="true">“</p>
          <blockquote class="display text-4xl leading-none sm:text-5xl">Kevin was a fantastic part of my team. He produced quality websites and was always eager to learn new skills and help with whatever he could.</blockquote>
          <figcaption class="mt-10 flex items-center gap-4 border-t border-noir/20 pt-6">
            <Image src={mandy} alt="Mandy Pawley" width={112} height={112} class="h-14 w-14 object-cover grayscale contrast-125" />
            <div class="text-sm"><p class="font-bold uppercase tracking-[.15em]">Mandy Pawley</p><p class="text-ash">Marketing Manager at Tindo Solar</p></div>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-media {
    -webkit-mask-image: linear-gradient(to bottom, #000 50%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 50%, transparent 100%);
  }
  @media (min-width: 1024px) {
    .hero-media {
      -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 42%), linear-gradient(to bottom, #000 62%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image: linear-gradient(to right, transparent 0%, #000 42%), linear-gradient(to bottom, #000 62%, transparent 100%);
      mask-composite: intersect;
    }
  }
</style>
