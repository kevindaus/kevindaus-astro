---
// Home — "Editorial" redesign (docs/kevinflorenzdaus-redesign-prompt-gpt.md):
// hero → selected work → about → services → technology stack → testimonials → writing → contact.
// Copy: src/data/home.ts (sources marked), src/data/testimonials.ts + src/data/stack.ts.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Testimonial from '../components/Testimonial.astro';
import ArticleItem from '../components/ArticleItem.astro';
import ContactButton from '../components/ContactButton.astro';
import { site } from '../data/site';
import { seo } from '../data/seo';
import { hero, about, services, contactCopy } from '../data/home';
import { testimonials } from '../data/testimonials';
import { stack } from '../data/stack';
import { getPosts, getWork } from '../lib/content';
import portrait from '../assets/people/kevin-florenz-daus.png';

const posts = (await getPosts()).slice(0, 3);
const work = (await getWork()).slice(0, 3);
const words = hero.headline.split(' ');
const agencies = [...new Set(work.map((w) => w.data.via).filter(Boolean))];
---
<BaseLayout title={seo.home.title} description={seo.home.description} path="/">
  <!-- HERO -->
  <section class="mx-auto max-w-wide px-5 pt-14 pb-20 sm:px-8 sm:pt-20 lg:px-12 lg:pt-28 lg:pb-28">
    <p class="hero-item mono text-muted" style="--i:0"><span class="mr-3 inline-block h-2 w-2 bg-accent align-middle" aria-hidden="true"></span>{hero.identity}</p>
    <h1 class="words mt-8 max-w-[11ch] text-hero font-bold">
      {words.map((w, i) => <><span class="w"><span class="wi" style={`--i:${i}`}>{w}</span></span>{i < words.length - 1 && ' '}</>)}
    </h1>
    <div class="mt-12 grid gap-10 border-t border-line pt-8 lg:grid-cols-12 lg:gap-8">
      <p class="hero-item max-w-[34ch] text-xl leading-snug text-fg lg:col-span-5" style="--i:5">{hero.supporting}</p>
      <div class="hero-item flex flex-wrap items-start gap-3 lg:col-span-3 lg:flex-col" style="--i:6">
        <a href={work.length ? '#work' : '/services/'} class="btn btn-primary">{work.length ? 'Explore My Work' : 'Explore Services'} <span class="arrow" aria-hidden="true">→</span></a>
        <a href="/about-me/" class="btn btn-secondary">About Me <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <dl class="hero-item grid gap-4 sm:grid-cols-3 lg:col-span-4 lg:grid-cols-1" style="--i:7">
        {hero.facts.map((f) => <div class="flex gap-4 lg:border-b lg:border-line lg:pb-3"><dt class="mono w-24 shrink-0 text-muted">{f.label}</dt><dd class="text-[.9375rem]">{f.value}</dd></div>)}
      </dl>
    </div>
  </section>

  <!-- SELECTED WORK -->
  {work.length > 0 && (
    <section id="work" class="mx-auto max-w-wide scroll-mt-24 px-5 py-16 sm:px-8 lg:px-12 lg:py-24" aria-labelledby="work-title">
      <SectionHeader index="01" label="Selected work" title="Things I’ve built." id="work-title" link={{ href: '/work/', label: 'All work' }}
        intro={agencies.length ? `Projects marked “with ${agencies.join('/')}” are websites I worked on while working with ${agencies.join(' and ')}.` : undefined} />
      <div class="mt-12 grid gap-x-8 gap-y-16 md:grid-cols-2">
        {work.map((item, i) => <div class:list={['reveal', i === 0 && 'md:col-span-2']}><ProjectCard item={item} index={i} wide={i === 0} /></div>)}
      </div>
    </section>
  )}

  <!-- ABOUT -->
  <section class="mx-auto max-w-wide px-5 py-16 sm:px-8 lg:px-12 lg:py-24" aria-labelledby="about-title">
    <div class="reveal grid gap-6 border-t border-fg pt-6 md:grid-cols-12 md:gap-8">
      <p class="mono text-muted md:col-span-3"><span class="text-accent-ink">02 </span>About</p>
      <div class="md:col-span-9">
        <h2 id="about-title" class="max-w-[18ch] text-display">{about.title}</h2>
      </div>
    </div>
    <div class="mt-12 grid gap-10 md:grid-cols-12 md:gap-8">
      <figure class="reveal md:col-span-3">
        <Image src={portrait} alt="Kevin Florenz Daus" width={360} height={414} class="h-auto w-48 border border-line bg-surface grayscale md:w-full" />
        <figcaption class="mono mt-3 text-muted">Kevin Florenz Daus</figcaption>
      </figure>
      <div class="reveal space-y-5 text-lg leading-relaxed md:col-span-6 md:col-start-5">
        {about.paragraphs.map((p, i) => <p class:list={[i > 0 && 'text-muted']}>{p}</p>)}
        <a href="/about-me/" class="group mono inline-flex items-center gap-2 pt-2 hover:text-accent-ink"><span class="link-underline">More about me</span> <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="mx-auto max-w-wide px-5 py-16 sm:px-8 lg:px-12 lg:py-24" aria-labelledby="services-title">
    <SectionHeader index="03" label="Services" title="Things I do to help you with your business." id="services-title" link={{ href: '/services/', label: 'All services' }} />
    <ol class="reveal-stagger mt-12 grid gap-px border-y border-line bg-line md:grid-cols-2 lg:grid-cols-3">
      {services.map((s, i) => (
        <li class="bg-bg">
          <a href={s.href} class="group flex h-full flex-col p-6 lg:p-8">
            <span class="mono text-accent-ink">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="item-title mt-8 text-2xl tracking-tight">{s.title}</h3>
            <p class="mt-3 text-muted">{s.text}</p>
            <span class="item-arrow mt-6 text-accent-ink" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- TECHNOLOGY STACK -->
  <section class="mx-auto max-w-wide px-5 py-16 sm:px-8 lg:px-12 lg:py-24" aria-labelledby="stack-title">
    <SectionHeader index="04" label="Technology" title="The stack." id="stack-title" size="title" />
    <div class="mt-10 md:grid md:grid-cols-12 md:gap-8">
      <dl class="reveal-stagger md:col-span-9 md:col-start-4">
        {stack.map((g) => (
          <div class="grid gap-3 border-b border-line py-5 sm:grid-cols-[10rem_1fr]">
            <dt class="mono pt-1 text-muted">{g.group}</dt>
            <dd class="font-display text-xl leading-relaxed tracking-tight">{g.items.join(' / ')}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="mx-auto max-w-wide px-5 py-16 sm:px-8 lg:px-12 lg:py-24" aria-labelledby="testimonials-title">
    <SectionHeader index="05" label="Testimonials" title="My Client Said" id="testimonials-title" size="title" />
    <div class="reveal-stagger mt-12 grid gap-12 md:grid-cols-12 md:gap-8">
      {testimonials.map((t, i) => <div class:list={[i === 0 ? 'md:col-span-5' : 'md:col-span-7']}><Testimonial {...t} index={i} /></div>)}
    </div>
  </section>

  <!-- WRITING -->
  <section class="mx-auto max-w-wide px-5 py-16 sm:px-8 lg:px-12 lg:py-24" aria-labelledby="writing-title">
    <SectionHeader index="06" label="Articles" title="Notes from the work." id="writing-title" size="title" link={{ href: '/articles/', label: 'All articles' }} />
    <div class="md:grid md:grid-cols-12 md:gap-8">
      <ul class="reveal-stagger mt-10 border-t border-line md:col-span-9 md:col-start-4">
        {posts.map((p, i) => <ArticleItem post={p} index={i} />)}
      </ul>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="bg-invert-bg text-invert-fg" aria-labelledby="contact-title">
    <div class="mx-auto max-w-wide px-5 py-20 sm:px-8 lg:px-12 lg:py-32">
      <p class="reveal mono opacity-75"><span class="text-accent">07 </span>Contact</p>
      <h2 id="contact-title" class="reveal mt-8 max-w-[14ch] text-hero font-bold">{contactCopy.heading}</h2>
      <div class="reveal mt-12 grid gap-10 border-t border-invert-fg/20 pt-8 md:grid-cols-12 md:gap-8">
        <p class="max-w-[36ch] text-xl leading-snug md:col-span-5">{contactCopy.intro}</p>
        <div class="md:col-span-3">
          <ContactButton label="Get in touch" class="btn border-transparent bg-accent text-accent-fg hover:bg-invert-fg hover:text-invert-bg" />
        </div>
        <dl class="space-y-3 md:col-span-4">
          {site.email && <div class="flex gap-4"><dt class="mono w-24 opacity-75">Email</dt><dd><a href={`mailto:${site.email}`} class="link-underline">{site.email}</a></dd></div>}
          <div class="flex gap-4"><dt class="mono w-24 opacity-75">LinkedIn</dt><dd><a href={site.linkedin} class="link-underline" rel="noopener" target="_blank">kevinflorenzdaus<span class="sr-only"> (opens in a new tab)</span> <span aria-hidden="true">↗</span></a></dd></div>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>
