---
// About Me — approved mockup UI/about-v1.html. Copy verbatim from /about-me/, in live order:
// intro → Education → Experience → Skill.
import BaseLayout from '../layouts/BaseLayout.astro';
import Portrait from '../components/Portrait.astro';
import Ticker from '../components/Ticker.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { seo } from '../data/seo';
import { jobs } from '../data/experience';
import { breadcrumb, mainEntityId } from '../lib/schema';

const skills: [string, string[]][] = [
  ['PHP / Laravel / Yii', ['Design and develop a PHP application using Laravel framework that optimices our clients business process through web automation.']],
  ['WordPress / Site Maintenance', ['Developed modern, responsive and SEO optimized site using WordPress CMS platform that streamlines clients and consumer business.', 'Perform website management skills that keep up and ready for business.']],
  ['SEO', ['Understand and implement technical SEO audits and changes']],
  ['Linux / Server Management', ['Optimize business revenue by migrating multiple websites from shared hosting to a cloud-based hosting site (DigitalOcean/ Cloudways)']],
];
const site = Astro.site!.href;
const url = new URL('/about-me/', Astro.site).href;
const person = mainEntityId(site, 'Person');
---
<BaseLayout title={seo.about.title} description={seo.about.description} path="/about-me/" pageType="AboutPage"
  schemaNodes={[
    breadcrumb(site, [{ name: 'About Me', url }]),
    { '@type': 'Person', '@id': person, alumniOf: { '@type': 'CollegeOrUniversity', name: "Saint Mary's University" },
      knowsAbout: ['PHP', 'Laravel', 'Yii', 'WordPress', 'SEO', 'Linux', 'TailwindCSS', 'VueJS', 'AlpineJS', 'Bootstrap', 'jQuery', 'Git', 'JavaScript'] },
  ]}>
  <section class="relative overflow-hidden pt-32 pb-16 sm:pt-40">
    <div class="spotlight absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      <Breadcrumbs items={[{ label: 'About Me' }]} />
      <h1 class="reveal display mt-6 text-display-page">About Me</h1>
    </div>
  </section>

  <Ticker items={['PHP Programmer', 'WordPress Developer', 'Loves Laravel']} label="PHP Programmer, WordPress Developer, Loves Laravel" />

  <section class="py-24 sm:py-36">
    <div class="mx-auto grid max-w-7xl items-start gap-12 px-4 sm:px-6 lg:grid-cols-12 lg:gap-16">
      <Portrait fig="02" class="lg:sticky lg:top-24 lg:col-span-5" />
      <div class="lg:col-span-7">
        <!-- live page renders this block 3x (responsive duplicates) and as an extra H1; shown once, as H2 -->
        <h2 class="reveal display text-[clamp(3rem,7vw,6.5rem)] leading-[.92]">Yoo! Hi there , <span class="text-smoke">I am</span> Kevin Florenz Daus</h2>
        <div class="reveal mt-12 space-y-6 border-l border-white/20 pl-6 text-base leading-relaxed text-bone/80 sm:text-lg">
          <p class="text-bone">WordPress &amp; Laravel FullStack Developer with a demonstrated history of working in the outsourcing/offshoring industry and a proven track record of building and maintaining PHP-based web applications.</p>
          <p>I have developed and maintained WordPress and Laravel applications for clients, implemented custom plugins and integrations with third-party APIs, and collaborated with cross-functional teams to plan and execute projects. I have also improved site performance and security through regular updates and monitoring.</p>
          <p>In addition to my experience with WordPress and Laravel, I am proficient in TailwindCSS, VueJS, AlpineJS, Bootstrap(CSS Framework), jQuery, Git, and JavaScript, and have strong problem-solving and communication skills.</p>
        </div>
        <div class="reveal mt-20">
          <Eyebrow n="01" text="Education" />
          <div class="mt-6 grid items-end gap-4 border border-white/15 p-6 sm:grid-cols-[1fr_auto] sm:p-8">
            <div>
              <h3 class="display text-4xl leading-none sm:text-5xl">Saint Mary's University</h3>
              <p class="mt-3 text-sm text-bone/75">Bachelor's Degree , Information Technology</p>
            </div>
            <p class="display text-5xl text-white/25">2009-2013</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-noir-900 py-24 sm:py-36">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="reveal">
        <Eyebrow n="02" text="Experience" />
        <h2 class="display mt-5 text-display-section">Experience</h2>
      </div>
      <ol class="mt-12 border-t border-white/15">
        {jobs.map(([role, org, dates, loc], i) => (
          <li class="reveal grid gap-3 border-b border-white/15 py-8 transition hover:bg-white/[.03] md:grid-cols-12 md:gap-8">
            <span class="text-xs text-smoke md:col-span-1">{String(i + 1).padStart(2, '0')}</span>
            <div class="md:col-span-7">
              <h3 class="display text-3xl leading-none sm:text-4xl">{role}</h3>
              <p class="mt-3 text-sm text-bone/75">{org}</p>
            </div>
            <div class="text-xs uppercase leading-loose tracking-[.18em] text-smoke md:col-span-4 md:text-right">
              <p class="text-bone">{dates}{dates.includes('CURRENT') && <span class="ml-3 inline-block h-2 w-2 bg-bone align-middle" aria-hidden="true"></span>}</p>
              <p>{loc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-24 sm:py-36">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="reveal">
        <Eyebrow n="03" text="Skill" />
        <h2 class="display mt-5 max-w-5xl text-display-section">Professional skills that I have</h2>
      </div>
      <div class="mt-14 grid border-t border-l border-white/15 md:grid-cols-2">
        {skills.map(([name, items], i) => (
          <article class="reveal border-r border-b border-white/15 p-6 sm:p-10">
            <p class="text-xs uppercase tracking-[.25em] text-smoke">No. 0{i + 1}</p>
            <h3 class="display mt-6 text-4xl sm:text-5xl">{name}</h3>
            <ul class="mt-6 space-y-3">
              {items.map((t) => <li class="relative pl-7 text-bone/80"><span class="absolute left-0 text-smoke" aria-hidden="true">—</span>{t}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
