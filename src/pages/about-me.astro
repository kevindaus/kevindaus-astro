---
// About — URL kept (/about-me/). VERBATIM from the live page: H1, intro heading + 3 paragraphs, rotating titles,
// experience, skills, education. The stack list (src/data/stack.ts) names only verified technologies.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { seo } from '../data/seo';
import { site as siteData } from '../data/site';
import { jobs } from '../data/experience';
import { stack } from '../data/stack';
import { breadcrumb, mainEntityId } from '../lib/schema';
import portrait from '../assets/people/kevin-florenz-daus.png';

const skills: [string, string[]][] = [
  ['PHP / Laravel / Yii', ['Design and develop a PHP application using Laravel framework that optimices our clients business process through web automation.']],
  ['WordPress / Site Maintenance', ['Developed modern, responsive and SEO optimized site using WordPress CMS platform that streamlines clients and consumer business.', 'Perform website management skills that keep up and ready for business.']],
  ['SEO', ['Understand and implement technical SEO audits and changes']],
  ['Linux / Server Management', ['Optimize business revenue by migrating multiple websites from shared hosting to a cloud-based hosting site (DigitalOcean/ Cloudways)']],
];
const site = Astro.site!.href;
const url = new URL('/about-me/', Astro.site).href;
const person = mainEntityId(site, 'Person');
---
<BaseLayout title={seo.about.title} description={seo.about.description} path="/about-me/" pageType="AboutPage"
  schemaNodes={[
    breadcrumb(site, [{ name: 'About Me', url }]),
    { '@type': 'Person', '@id': person, alumniOf: { '@type': 'CollegeOrUniversity', name: "Saint Mary's University" },
      knowsAbout: ['PHP', 'Laravel', 'Yii', 'WordPress', 'SEO', 'Linux', 'Docker', 'TailwindCSS', 'VueJS', 'AlpineJS', 'Bootstrap', 'jQuery', 'Git', 'JavaScript'] },
  ]}>
  <div class="mx-auto max-w-wide px-5 pt-12 sm:px-8 sm:pt-16 lg:px-12">
    <Breadcrumbs items={[{ label: 'About Me' }]} />
    <h1 class="mt-8 text-hero font-bold">About Me</h1>
    <!-- the live page's rotating titles, verbatim -->
    <p class="mono mt-6 text-muted">PHP Programmer / WordPress Developer / Loves Laravel</p>

    <!-- INTRO -->
    <section class="mt-16 grid gap-10 border-t border-fg pt-8 md:grid-cols-12 md:gap-8" aria-labelledby="intro">
      <figure class="md:col-span-3">
        <Image src={portrait} alt="Kevin Florenz Daus" width={360} height={414} loading="eager" class="h-auto w-48 border border-line bg-surface grayscale md:w-full" />
      </figure>
      <div class="md:col-span-8 md:col-start-5">
        <h2 id="intro" class="text-title">Yoo! Hi there , I am Kevin Florenz Daus</h2>
        <div class="mt-8 space-y-5 text-lg leading-relaxed">
          <p class="text-xl leading-snug">WordPress &amp; Laravel FullStack Developer with a demonstrated history of working in the outsourcing/offshoring industry and a proven track record of building and maintaining PHP-based web applications.</p>
          <p class="text-muted">I have developed and maintained WordPress and Laravel applications for clients, implemented custom plugins and integrations with third-party APIs, and collaborated with cross-functional teams to plan and execute projects. I have also improved site performance and security through regular updates and monitoring.</p>
          <p class="text-muted">In addition to my experience with WordPress and Laravel, I am proficient in TailwindCSS, VueJS, AlpineJS, Bootstrap(CSS Framework), jQuery, Git, and JavaScript, and have strong problem-solving and communication skills.</p>
        </div>
      </div>
    </section>
  </div>

  <!-- EXPERIENCE -->
  <section class="mx-auto mt-24 max-w-wide px-5 sm:px-8 lg:px-12" aria-labelledby="experience">
    <SectionHeader index="01" label="Experience" title="Experience" id="experience" size="title" />
    <ol class="reveal-stagger mt-10 md:grid md:grid-cols-12 md:gap-8">
      <li class="hidden md:col-span-3 md:block" aria-hidden="true"></li>
      {jobs.map(([role, org, dates, loc]) => (
        <li class="grid gap-x-8 gap-y-1 border-b border-line py-6 md:col-span-9 md:col-start-4 md:grid-cols-[1fr_15rem]">
          <div>
            <h3 class="text-xl tracking-tight">{role}</h3>
            <p class="mt-1 text-muted">{org}</p>
          </div>
          <div class="mono text-muted md:text-right">
            <p class:list={[dates.includes('CURRENT') && 'text-accent-ink']}>{dates}</p>
            <p>{loc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- SKILLS -->
  <section class="mx-auto mt-24 max-w-wide px-5 sm:px-8 lg:px-12" aria-labelledby="skills">
    <SectionHeader index="02" label="Skill" title="Professional skills that I have" id="skills" size="title" />
    <div class="reveal-stagger mt-10 grid gap-px border-y border-line bg-line md:grid-cols-2">
      {skills.map(([name, items], i) => (
        <div class="bg-bg p-6 lg:p-8">
          <p class="mono text-accent-ink">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="mt-6 text-2xl tracking-tight">{name}</h3>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-muted marker:text-subtle">{items.map((t) => <li>{t}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <!-- STACK -->
  <section class="mx-auto mt-24 max-w-wide px-5 sm:px-8 lg:px-12" aria-labelledby="stack">
    <SectionHeader index="03" label="Technology" title="Stack" id="stack" size="title" />
    <div class="mt-10 md:grid md:grid-cols-12 md:gap-8">
      <dl class="reveal-stagger md:col-span-9 md:col-start-4">
        {stack.map((g) => (
          <div class="grid gap-3 border-b border-line py-5 sm:grid-cols-[10rem_1fr]">
            <dt class="mono pt-1 text-muted">{g.group}</dt>
            <dd class="font-display text-xl leading-relaxed tracking-tight">{g.items.join(' / ')}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- EDUCATION -->
  <section class="mx-auto mt-24 max-w-wide px-5 sm:px-8 lg:px-12" aria-labelledby="education">
    <SectionHeader index="04" label="Education" title="Education" id="education" size="title" />
    <div class="reveal mt-10 md:grid md:grid-cols-12 md:gap-8">
      <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line pb-6 md:col-span-9 md:col-start-4">
        <div><h3 class="text-xl tracking-tight">Saint Mary's University</h3><p class="mt-1 text-muted">Bachelor's Degree , Information Technology</p></div>
        <p class="mono text-muted">2009-2013</p>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-24 max-w-wide px-5 sm:px-8 lg:px-12">
    <div class="reveal flex flex-wrap items-end justify-between gap-8 border-t border-fg pt-8">
      <h2 class="max-w-[14ch] text-display">Need a hand on your project?</h2>
      <a href={siteData.contactPath} class="btn btn-primary">Get in touch <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
