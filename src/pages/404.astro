---
// 404 in the same style: status code, one line, the main nav.
import BaseLayout from '../layouts/BaseLayout.astro';
import { seo } from '../data/seo';
import { site } from '../data/site';
import { getWork } from '../lib/content';
const hasWork = (await getWork()).length > 0;
const nav = site.nav.filter((l) => !l.needsWork || hasWork);
---
<BaseLayout title={seo.notFound.title} path="/404/" noindex>
  <section class="mx-auto max-w-wide px-5 pt-20 sm:px-8 sm:pt-28 lg:px-12">
    <p class="mono text-muted"><span class="text-accent-ink">404 </span>Error</p>
    <h1 class="mt-8 text-hero font-bold">Page not found.</h1>
    <p class="mt-6 max-w-[40ch] text-xl leading-snug text-muted">The page you’re after doesn’t exist, or it has moved.</p>
    <ul class="mono mt-12 flex flex-wrap gap-x-8 gap-y-3 border-t border-fg pt-6">
      <li><a href="/" class="text-link link-underline">Home</a></li>
      {nav.map((l) => <li><a href={l.href} class="text-link link-underline">{l.label}</a></li>)}
      <li><a href="/articles/" class="text-link link-underline">Articles</a></li>
    </ul>
  </section>
</BaseLayout>
