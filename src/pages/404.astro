---
// 404 — no live equivalent; only the status code plus existing nav labels (no new prose). Logged.
import BaseLayout from '../layouts/BaseLayout.astro';
import { seo } from '../data/seo';
import { site } from '../data/site';
---
<BaseLayout title={seo.notFound.title} path="/404/" noindex>
  <section class="relative flex min-h-[80svh] items-end overflow-hidden pt-32 pb-20">
    <div class="spotlight absolute inset-0" aria-hidden="true"></div>
    <div class="blinds-shadow absolute inset-0 opacity-50" aria-hidden="true"></div>
    <div class="relative mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h1 class="reveal display text-display-page">404</h1>
      <ul class="reveal mt-10 flex flex-wrap gap-3">
        {site.nav.map((l) => <li><a href={l.href} class="inline-flex border border-white/30 px-7 py-4 text-xs font-bold uppercase tracking-[.25em] transition hover:border-bone">{l.label}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
