---
// One article in a list: date, chips, title, excerpt, "Read More »" (all verbatim from the live archive).
import CategoryChip from './CategoryChip.astro';
import { postPath, fmtDate, type Post } from '../lib/content';
interface Props { post: Post; variant?: 'home' | 'archive'; class?: string }
const { post, variant = 'archive', class: cls = '' } = Astro.props;
const { title, pubDate, excerpt, categories } = post.data;
---
<li class:list={['reveal border-b border-white/15', cls]} data-cats={categories.join('|')}>
  <a href={postPath(post)} class="group grid items-baseline gap-3 py-8 transition hover:bg-white/[.03] md:grid-cols-12 md:gap-8 md:py-10">
    <div class="space-y-3 md:col-span-2">
      <p class="text-xs uppercase tracking-[.2em] text-smoke"><time datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time></p>
      {variant === 'archive' && <div class="flex flex-wrap gap-1.5">{categories.map((c) => <CategoryChip label={c} />)}</div>}
    </div>
    <div class="md:col-span-6">
      {variant === 'archive'
        ? <h2 class="display text-3xl leading-[1.02] sm:text-4xl">{title}</h2>
        : <h3 class="display text-3xl leading-none sm:text-4xl">{title}</h3>}
    </div>
    <div class:list={[variant === 'archive' ? 'md:col-span-4' : 'md:col-span-3']}>
      <p class="text-sm text-bone/65">{excerpt}</p>
      {variant === 'archive' && <p class="mt-4 text-xs font-bold uppercase tracking-[.25em] underline-offset-4 group-hover:underline">Read More »</p>}
    </div>
    {variant === 'home' && <span class="hidden justify-self-end text-xl transition group-hover:translate-x-1 md:col-span-1 md:block" aria-hidden="true">→</span>}
  </a>
</li>
