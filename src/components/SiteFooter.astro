---
import { site } from '../data/site';
---
<footer class="overflow-hidden border-t border-white/10">
  <div class="mx-auto max-w-7xl px-4 pt-16 pb-8 sm:px-6">
    <div class="grid gap-10 text-sm md:grid-cols-12">
      <div class="md:col-span-6">
        <p class="text-xs uppercase tracking-[.25em]">Kevin Florenz Daus</p>
        <p class="mt-2 text-smoke">{site.tagline}</p>
      </div>
      <ul class="space-y-2 text-smoke md:col-span-3">
        {site.nav.map((l) => <li><a href={l.href} class="link-u hover:text-bone">{l.label}</a></li>)}
      </ul>
      <ul class="space-y-2 text-smoke md:col-span-3">
        {site.footerSocials.map((s) => <li><a href={s.href} class="link-u hover:text-bone" rel="me noopener" target="_blank">{s.label} ↗</a></li>)}
      </ul>
    </div>
    <div class="display footer-name mt-16 whitespace-nowrap text-display-footer text-white/[.07] before:content-[attr(data-text)]" data-text="Kevin Florenz Daus" aria-hidden="true"></div>
  </div>
</footer>
