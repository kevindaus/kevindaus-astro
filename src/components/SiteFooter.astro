---
// Minimal footer: copyright, navigation, verified social links.
import { site, socials } from '../data/site';
import { getWork } from '../lib/content';

const hasWork = (await getWork()).length > 0;
const nav = site.footerNav.filter((l) => !l.needsWork || hasWork);
const year = new Date().getFullYear();
---
<footer class="mt-28 border-t border-line" transition:persist="site-footer">
  <div class="mx-auto grid max-w-wide gap-10 px-5 py-12 sm:px-8 md:grid-cols-12 lg:px-12">
    <div class="md:col-span-5">
      <a href="/" class="font-display text-4xl leading-none font-bold tracking-[-0.04em]" aria-label="KFD. Kevin Florenz Daus, home">KFD<span class="text-accent">.</span></a>
      <p class="mono mt-4 text-muted">{site.tagline}</p>
    </div>
    <nav aria-label="Footer" class="md:col-span-3">
      <p class="mono text-subtle">Pages</p>
      <ul class="mt-4 space-y-2">
        {nav.map((l) => <li><a href={l.href} class="link-underline hover:text-accent-ink" {...(l.external && { rel: 'noopener', target: '_blank' })}>{l.label}{l.external && <><span class="sr-only"> on LinkedIn (opens in a new tab)</span> <span aria-hidden="true">↗</span></>}</a></li>)}
      </ul>
    </nav>
    <div class="md:col-span-4">
      <p class="mono text-subtle">Elsewhere</p>
      <ul class="mt-4 space-y-2">
        {socials.map((s) => <li><a href={s.href} class="link-underline hover:text-accent-ink" rel="me noopener" target="_blank">{s.label}<span class="sr-only"> (opens in a new tab)</span> <span aria-hidden="true">↗</span></a></li>)}
        <li><a href="/rss.xml" class="link-underline hover:text-accent-ink">RSS</a></li>
      </ul>
    </div>
  </div>
  <div class="mx-auto flex max-w-wide flex-wrap justify-between gap-2 border-t border-line px-5 py-5 sm:px-8 lg:px-12">
    <p class="mono text-muted">© {year} Kevin Florenz Daus</p>
    <p class="mono text-muted">Built with <a href="https://astro.build/" class="link-underline hover:text-fg" rel="noopener">Astro</a></p>
  </div>
</footer>
