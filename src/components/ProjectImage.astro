---
// A project's screenshot, or — until a real one is supplied — a clearly marked placeholder frame
// (never stock imagery). Fills its parent; the parent sets the aspect ratio.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src?: ImageMetadata; alt?: string; label?: string; sizes?: string; eager?: boolean; position?: string }
const { src, alt = '', label = 'Project', sizes = '(min-width: 1024px) 620px, 92vw', eager = false, position = 'center' } = Astro.props;
---
{src ? (
  <Image src={src} alt={alt} widths={[480, 800, 1240]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} class="h-full w-full object-cover" style={`object-position:${position}`} />
) : (
  <div class="placeholder-frame relative flex h-full w-full flex-col justify-between p-5 sm:p-6" role="img" aria-label={`Placeholder: ${label} screenshot to be supplied`}>
    <span class="mono text-muted" aria-hidden="true">[ placeholder ]</span>
    <span class="font-display text-[clamp(1.5rem,4vw,2.75rem)] leading-none font-semibold tracking-tight text-subtle" aria-hidden="true">Screenshot<br />to be supplied</span>
  </div>
)}
