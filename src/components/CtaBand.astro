---
// "Need a hand on your project?" — verbatim from the live /articles/ page; used at the end of every page (logged divergence).
import { site } from '../data/site';
---
<section class="relative overflow-hidden border-t border-white/10">
  <div class="spotlight absolute inset-0" aria-hidden="true"></div>
  <div class="blinds-shadow absolute inset-0 opacity-60" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-4 py-28 text-center sm:px-6 sm:py-40">
    <h2 class="reveal display text-display-cta">Need a hand on your project?</h2>
    <a href={site.contactUrl} class="reveal group mt-12 inline-flex items-center gap-4 bg-bone px-10 py-5 text-sm font-bold uppercase tracking-[.3em] text-noir transition hover:bg-white">
      Contact Me <span class="transition group-hover:translate-x-1" aria-hidden="true">→</span>
    </a>
  </div>
</section>
