---
// Code block: Shiki highlighting (light/dark), language label and a Copy button (ui.ts, delegated).
import { Code } from 'astro:components';
interface Props { code: string; lang?: string }
const { code, lang = 'bash' } = Astro.props;
---
<div class="code-block not-prose">
  <div class="code-block__bar">
    <span>{lang}</span>
    <button type="button" class="copy-btn" data-copy aria-live="polite">
      <span class="copy-idle">Copy</span>
      <span class="copy-done items-center gap-1"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>Copied</span>
    </button>
  </div>
  <Code code={code} lang={lang as any} themes={{ light: 'github-light', dark: 'github-dark' }} wrap={false} />
</div>
