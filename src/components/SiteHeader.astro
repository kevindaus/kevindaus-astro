---
// Minimal sticky header: KFD. wordmark, Work / About / Contact, theme toggle. One nav list for all
// screen sizes (the mobile menu renders the same items). Persisted across page transitions;
// ui.ts updates aria-current after each navigation.
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';
import { getWork } from '../lib/content';

const hasWork = (await getWork()).length > 0;
const nav = site.nav.filter((l) => !l.needsWork || hasWork);
const here = Astro.url.pathname;
const isActive = (href: string) => here.startsWith(href);
---
<header class="site-header sticky top-0 z-50" transition:persist="site-header" transition:name="site-header">
  <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-10 focus:bg-fg focus:px-4 focus:py-2 focus:text-bg">Skip to content</a>
  <div class="mx-auto flex h-16 max-w-wide items-center justify-between gap-6 px-5 sm:h-20 sm:px-8 lg:px-12">
    <a href="/" class="font-display text-2xl leading-none font-bold tracking-[-0.04em]" aria-label="KFD. Kevin Florenz Daus, home">KFD<span class="text-accent">.</span></a>

    <nav aria-label="Main" class="flex items-center gap-2">
      <ul class="mono hidden items-center gap-8 pr-4 text-[.8125rem] md:flex">
        {nav.map((l, i) => (
          <li><a href={l.href} data-nav class="link-underline py-2 text-muted hover:text-fg aria-[current=page]:text-fg" aria-current={isActive(l.href) ? 'page' : undefined}><span class="text-subtle" aria-hidden="true">0{i + 1} </span>{l.label}</a></li>
        ))}
      </ul>
      <ThemeToggle />
      <button type="button" data-menu-toggle class="grid h-11 w-11 place-items-center text-fg md:hidden" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 9h18M3 15h18" /></svg>
      </button>
    </nav>
  </div>

  <div id="mobile-menu" class="mobile-menu absolute inset-x-0 top-full border-b border-line bg-bg md:hidden">
    <ul class="mx-auto max-w-wide px-5 py-6 sm:px-8">
      {nav.map((l, i) => (
        <li style={`--i:${i}`}>
          <a href={l.href} data-nav class="flex items-baseline gap-4 border-b border-line py-4 font-display text-3xl font-semibold tracking-tight aria-[current=page]:text-accent-ink" aria-current={isActive(l.href) ? 'page' : undefined}>
            <span class="mono text-subtle" aria-hidden="true">0{i + 1}</span>{l.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>
