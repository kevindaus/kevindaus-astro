---
import LogoMark from './LogoMark.astro';
import { site } from '../data/site';

const here = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? here === '/' : here.startsWith(href) || (href === '/articles/' && /^\/20\d\d\//.test(here)));
---
<div class="curtain" aria-hidden="true"><span>Kevin Florenz Daus</span></div>
<header class="site-header fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-noir/80 backdrop-blur-md">
  <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:bg-bone focus:px-4 focus:py-2 focus:text-noir">Skip to content</a>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-3">
      <LogoMark />
      <span class="hidden text-xs uppercase tracking-[.25em] sm:block">Kevin Florenz Daus</span>
    </a>
    <nav aria-label="Main">
      <ul class="hidden items-center gap-8 text-xs uppercase tracking-[.2em] text-smoke md:flex">
        {site.nav.map((l) => (
          <li>
            <a href={l.href} class={isActive(l.href) ? 'text-bone' : 'link-u hover:text-bone'} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a href={site.contactUrl} class="hidden items-center gap-2 border border-bone px-4 py-2 text-xs uppercase tracking-[.2em] transition hover:bg-bone hover:text-noir sm:inline-flex">Contact Me <span aria-hidden="true">→</span></a>
      <button id="menuBtn" type="button" class="grid h-10 w-10 place-items-center border border-white/20 md:hidden" aria-label="Menu" aria-expanded="false" aria-controls="mobileMenu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
      </button>
    </div>
  </div>
  <div id="mobileMenu" class="hidden border-t border-white/10 bg-noir px-4 pb-6 md:hidden">
    {site.nav.map((l) => (
      <a href={l.href} class:list={['display block py-3 text-4xl', !isActive(l.href) && 'text-smoke']}>{l.label}</a>
    ))}
    <a href={site.contactUrl} class="mt-3 block bg-bone py-3 text-center text-xs uppercase tracking-[.2em] text-noir">Contact Me →</a>
  </div>
</header>
