---
// Editorial pull-quote. The quote is verbatim; `lead` (an optional first sentence, also verbatim) is set large.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { quote: string; lead?: string; name: string; role: string; photo?: ImageMetadata; index?: number }
const { quote, lead, name, role, photo, index = 0 } = Astro.props;
---
<figure class="flex h-full flex-col border-t border-line pt-6">
  <p class="mono text-accent-ink" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
  <blockquote class="mt-6 flex-1">
    <p class="font-display text-[clamp(1.5rem,1.1rem+1.4vw,2.25rem)] leading-[1.15] font-medium tracking-[-0.025em]">
      <span class="text-accent" aria-hidden="true">“</span>{lead ?? quote}{!lead && <span class="text-accent" aria-hidden="true">”</span>}
    </p>
    {lead && <p class="mt-5 max-w-[58ch] text-muted">{quote}<span aria-hidden="true">”</span></p>}
  </blockquote>
  <figcaption class="mt-8 flex items-center gap-4">
    {photo && <Image src={photo} alt="" width={96} height={96} class="h-12 w-12 rounded-full object-cover grayscale" />}
    <span><span class="block font-semibold">{name}</span><span class="mono text-muted">{role}</span></span>
  </figcaption>
</figure>
