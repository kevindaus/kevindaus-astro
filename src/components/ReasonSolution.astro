---
// One "Reason: … / Solution: …" pair (WooCommerce post). Labels are verbatim from the live post.
interface Props { reason: string }
const { reason } = Astro.props;
---
<li class="grid border-r border-b border-white/15 sm:grid-cols-2">
  <div class="border-white/15 p-6 sm:border-r">
    <p class="label"><strong class="font-normal">Reason:</strong></p>
    <p class="display mt-3 text-3xl leading-none text-bone">{reason}</p>
  </div>
  <div class="border-t border-white/15 bg-white/[.03] p-6 sm:border-t-0">
    <p class="label"><strong class="font-normal">Solution:</strong></p>
    <p class="mt-3 text-bone"><slot /></p>
  </div>
</li>
