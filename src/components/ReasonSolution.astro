---
// One "Reason: … / Solution: …" pair (WooCommerce post). Labels are verbatim from the live post.
interface Props { reason: string }
const { reason } = Astro.props;
---
<li class="grid border-b border-line last:border-b-0 sm:grid-cols-2">
  <div class="p-5">
    <p class="mono text-subtle"><strong class="font-normal">Reason:</strong></p>
    <p class="mt-1.5 font-medium">{reason}</p>
  </div>
  <div class="border-t border-line bg-surface p-5 sm:border-t-0 sm:border-l">
    <p class="mono text-subtle"><strong class="font-normal">Solution:</strong></p>
    <p class="mt-1.5 [&_code]:font-mono [&_code]:text-[.875em]"><slot /></p>
  </div>
</li>
