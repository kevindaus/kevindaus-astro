---
// Grayscale portrait with venetian-blind light, vignette and a "Fig." caption. Develops on reveal (motion §7).
import { Picture } from 'astro:assets';
import portrait from '../assets/people/kevin-florenz-daus.png';
interface Props { fig: string; class?: string; eager?: boolean }
const { fig, class: cls = '', eager = false } = Astro.props;
---
<figure class:list={['reveal relative', cls]}>
  <div class="relative aspect-[471/542] overflow-hidden bg-noir-800">
    <Picture src={portrait} formats={['avif', 'webp']} alt="Kevin Florenz Daus" widths={[471]} sizes="(min-width: 1024px) 471px, 90vw"
      loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'}
      class="noir-img absolute inset-0 h-full w-full object-contain object-bottom" />
    <div class="blinds-shadow absolute inset-0" aria-hidden="true"></div>
    <div class="blinds absolute inset-0" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_30%_20%,transparent_30%,rgba(0,0,0,.7)_100%)]" aria-hidden="true"></div>
  </div>
  <figcaption class="mt-3 flex justify-between text-[11px] uppercase tracking-[.25em] text-smoke"><span>Fig. {fig}</span><span>Kevin Florenz Daus</span></figcaption>
  <slot />
</figure>
