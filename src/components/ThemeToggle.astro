---
// Light/dark toggle. Behaviour lives in src/scripts/ui.ts (delegated click on [data-theme-toggle]);
// the first paint follows the saved choice, else prefers-color-scheme (inline script in BaseLayout).
---
<button type="button" data-theme-toggle class="relative grid h-9 w-9 place-items-center rounded-md text-muted transition-colors duration-(--duration-fast) hover:bg-surface hover:text-fg" aria-label="Toggle dark mode" aria-pressed="false">
  <svg class="theme-icon theme-icon--sun absolute h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg class="theme-icon theme-icon--moon absolute h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
  </svg>
</button>
