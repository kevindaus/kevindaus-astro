---
// Thin accent bar at the top of article pages. CSS scroll-driven animation where supported;
// otherwise the script sets --progress. Hidden under reduced motion (motion.css).
---
<div class="read-progress" data-read-progress aria-hidden="true"></div>

<script>
  let stop: (() => void) | undefined;
  function init() {
    stop?.();
    const bar = document.querySelector<HTMLElement>('[data-read-progress]');
    if (!bar || CSS.supports('animation-timeline: scroll()')) return;
    let raf = 0;
    const update = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      bar.style.setProperty('--progress', String(max > 0 ? Math.min(1, scrollY / max) : 0));
    };
    const tick = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); };
    addEventListener('scroll', tick, { passive: true });
    update();
    stop = () => removeEventListener('scroll', tick);
  }
  document.addEventListener('astro:page-load', init);
</script>
