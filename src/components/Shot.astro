---
// A terminal screenshot inside terminal chrome.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; label?: string }
const { src, alt, label = 'terminal' } = Astro.props;
---
<figure class="term not-prose my-8">
  <div class="term-bar"><span>{label}</span><span>screenshot</span></div>
  <Image src={src} alt={alt} class="shot block h-auto w-full" />
</figure>
